ENVIRONMENT=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Supabase PostgreSQL Connection String (Session Pooler on port 5432)
# Replace [YOUR-DATABASE-PASSWORD] with your actual Supabase database password
DATABASE_URL=postgresql+psycopg2://postgres.jjwzvsamqsujsozgjzid:[YOUR-DATABASE-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth and Storage Settings
SUPABASE_URL=https://jjwzvsamqsujsozgjzid.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_ISSUER=https://jjwzvsamqsujsozgjzid.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://jjwzvsamqsujsozgjzid.supabase.co/auth/v1/.well-known/jwks.json

# CORS & Timezone (Includes local dev and Vercel domains)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app
APP_TIMEZONE=Asia/Karachi
